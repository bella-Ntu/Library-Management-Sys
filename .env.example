# Copy this file to .env and set values locally.
# Never use the VITE_ prefix for secrets.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>
JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_LIBRARIAN_USERNAME=
BOOTSTRAP_LIBRARIAN_SURNAME=
BOOTSTRAP_LIBRARIAN_PASSWORD=
PORT=3000
